# ax-harness: Antigravity CLI (agy) launcher for the AX in-container wrapper
# contract.
#
# Inputs provided by the mounted AX runner:
#   AX_GOAL_FILE    path to the task's goal (spec.config.prompt)
#   AX_CONFIG_FILE  optional path to spec.config serialized as JSON
#   cwd             the task's workspace
#
# Optional environment variables:
#   AGY_VERSION         version installed on runtime fallback (default: "latest")
#   AGY_INSTALL_SCRIPT  installer script path (default: /usr/local/share/ax/install-agy.sh)
#   AGY_BIN             binary name or path (default: "agy")

set -euo pipefail

goal_file="${AX_GOAL_FILE:?AX_GOAL_FILE is not set; ax-harness must be started by the AX runner}"
config_file="${AX_CONFIG_FILE:-}"

if [[ ! -s "${goal_file}" ]]; then
  echo "ax-harness: empty goal in ${goal_file}; set spec.config.prompt" >&2
  exit 2
fi

export HOME="${HOME:-/root}"
export PATH="${HOME}/.local/bin:${PATH}"
export AGY_CLI_DISABLE_AUTO_UPDATE="${AGY_CLI_DISABLE_AUTO_UPDATE:-true}"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AGY_BIN="${AGY_BIN:-agy}"
if ! command -v "${AGY_BIN}" >/dev/null 2>&1; then
  default_installer="/usr/local/share/ax/install-agy.sh"
  if [[ ! -x "${default_installer}" && -x "${SCRIPT_DIR}/install-agy.sh" ]]; then
    default_installer="${SCRIPT_DIR}/install-agy.sh"
  fi
  installer="${AGY_INSTALL_SCRIPT:-${default_installer}}"
  version="${AGY_VERSION:-latest}"
  echo "ax-harness: ${AGY_BIN} not found on PATH; installing agy (${version})..." >&2
  "${installer}" "${version}" "${HOME}/.local/bin"
fi

if ! command -v "${AGY_BIN}" >/dev/null 2>&1; then
  echo "ax-harness: ${AGY_BIN} is still not available on PATH after install" >&2
  exit 127
fi

# Prints outputFile (empty string when unset), followed by NUL-delimited agy args.
mapfile -d '' -t parsed < <(python3 - "${config_file}" "${goal_file}" "${PWD}" <<'PY'
import json
import os
import re
import sys

cfg_path, goal_path, cwd = sys.argv[1], sys.argv[2], sys.argv[3]
cfg = {}
if cfg_path:
    with open(cfg_path, "r", encoding="utf-8") as f:
        raw = f.read().strip()
        if raw:
            cfg = json.loads(raw)
with open(goal_path, "r", encoding="utf-8") as f:
    goal = f.read()


def to_flag(key: str) -> str:
    if not re.match(r"^[a-z][a-z0-9]*([A-Z][a-z0-9]+)*$", key):
        raise ValueError(f"spec.config key {key!r} must be camelCase")
    return "--" + re.sub(r"([A-Z])", lambda m: "-" + m.group(1).lower(), key)


output_file = cfg.pop("outputFile", "") or ""
cfg.pop("prompt", None)

settings = cfg.pop("settings", None) or {}
if not isinstance(settings, dict):
    raise ValueError("spec.config.settings must be an object")
adc = os.environ.get("AGY_ADC_AUTH", "").strip().lower() in ("1", "true", "on")
if os.environ.get("GEMINI_API_KEY") and not adc:
    settings = {"modelProvider": "gemini", **settings}

cfg.setdefault("dangerouslySkipPermissions", True)
cfg.setdefault("addDir", [cwd])

out = []
for key in sorted(cfg):
    val = cfg[key]
    flag = to_flag(key)
    if isinstance(val, bool):
        out.append(flag if val else f"{flag}=false")
    elif isinstance(val, list):
        for elem in val:
            if isinstance(elem, (dict, list, bool)) or elem is None:
                raise ValueError(
                    f"spec.config.{key}: list elements must be strings or numbers"
                )
            out.append(f"{flag}={elem}")
    elif isinstance(val, dict):
        out.append(f"{flag}={json.dumps(val, separators=(',', ':'))}")
    elif isinstance(val, (str, int, float)):
        out.append(f"{flag}={val}")
    elif val is not None:
        raise ValueError(f"spec.config.{key}: unsupported value {val!r}")

if settings:
    out.append(f"--settings={json.dumps(settings, separators=(',', ':'))}")
out.append(f"--print={goal}")

for item in [output_file] + out:
    sys.stdout.buffer.write(item.encode("utf-8") + b"\0")
PY
)

output_file="${parsed[0]}"
agy_args=("${parsed[@]:1}")

if [[ -z "${output_file}" ]]; then
  exec "${AGY_BIN}" "${agy_args[@]}"
fi

mkdir -p "$(dirname "${output_file}")"
set +e
"${AGY_BIN}" "${agy_args[@]}" | tee "${output_file}"
status="${PIPESTATUS[0]}"
set -e
exit "${status}"
